# - resource -------------------------------------------------------------------

<http://ltc-ig.fhir.tw/Patient/ltc-patient-cs100-example> a fhir:Patient ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "ltc-patient-cs100-example"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: Patient ltc-patient-cs100-example</b></p><a name=\"ltc-patient-cs100-example\"> </a><a name=\"hcltc-patient-cs100-example\"> </a><p style=\"border: 1px #661aff solid; background-color: #e6e6ff; padding: 10px;\">王小明 (no stated gender), DoB Unknown ( https://example.org/mrn#A0001)</p><hr/></div>"
  ] ;
  fhir:Patient.identifier [
     fhir:index 0 ;
     fhir:Identifier.system [ fhir:value "https://example.org/mrn" ] ;
     fhir:Identifier.value [ fhir:value "A0001" ]
  ] ;
  fhir:Patient.name [
     fhir:index 0 ;
     fhir:HumanName.text [ fhir:value "王小明" ]
  ] .

# - ontology header ------------------------------------------------------------

<http://ltc-ig.fhir.tw/Patient/ltc-patient-cs100-example.ttl> a owl:Ontology ;
