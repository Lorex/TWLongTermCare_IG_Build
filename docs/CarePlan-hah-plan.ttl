  ] ;
  fhir:CarePlan.addresses [
     fhir:index 0 ;
     fhir:link <http://ltc-ig.fhir.tw/Condition/hah-condition> ;
     fhir:Reference.reference [ fhir:value "Condition/hah-condition" ]
  ] ;
  fhir:CarePlan.goal [
     fhir:index 0 ;
     fhir:link <http://ltc-ig.fhir.tw/Goal/hah-goal> ;
