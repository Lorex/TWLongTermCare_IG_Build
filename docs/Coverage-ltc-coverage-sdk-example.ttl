  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: Coverage ltc-coverage-sdk-example</b></p><a name=\"ltc-coverage-sdk-example\"> </a><a name=\"hcltc-coverage-sdk-example\"> </a><p><b>status</b>: Active</p><p><b>beneficiary</b>: <a href=\"Patient-ltc-patient-sdk-example.html\">王小明 Male, DoB: 1950-01-01 ( Provider number (use: official, ))</a></p><p><b>payor</b>: <a href=\"Organization-ltc-organization-sdk-example.html\">Organization OOO長期照顧管理中心</a></p></div>"
  ] ;
  fhir:Coverage.status [ fhir:value "active"] ;
  fhir:Coverage.beneficiary [
