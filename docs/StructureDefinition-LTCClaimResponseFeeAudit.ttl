       fhir:ElementDefinition.short [ fhir:value "Coverage to be used for adjudication" ] ;
       fhir:ElementDefinition.definition [ fhir:value "A flag to indicate that this Coverage is to be used for adjudication of this claim when set to true." ] ;
       fhir:ElementDefinition.comment [ fhir:value "A patient may (will) have multiple insurance policies which provide reimbursement for healthcare services and products. For example a person may also be covered by their spouse's policy and both appear in the list (and may be from the same insurer). This flag will be set to true for only one of the listed policies and that policy will be used for adjudicating this claim. Other claims would be created to request adjudication against the other listed policies." ] ;
       fhir:ElementDefinition.requirements [ fhir:value "To identify which coverage in the list is being used to adjudicate this claim." ] ;
