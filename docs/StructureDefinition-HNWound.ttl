         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "If Observation.code is the same as an Observation.component.code then the value element associated with the code SHALL NOT be present" ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "value.empty() or component.code.where(coding.intersect(%resource.code.coding).exists()).empty()" ] ;
         fhir:ElementDefinition.constraint.xpath [ fhir:value "not(f:*[starts-with(local-name(.), 'value')] and (for $coding in f:code/f:coding return f:component/f:code/f:coding[f:code/@value=$coding/f:code/@value] [f:system/@value=$coding/f:system/@value]))" ] ;
