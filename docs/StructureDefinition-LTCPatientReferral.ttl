       fhir:ElementDefinition.definition [ fhir:value "小寫的ISO-639-1字母兩個代碼表示的語言，後面可以有連字符號，大寫的ISO-3166-1字母兩個代碼表示使用此語言的地區；例如「en 」代表英語，或者 「en-US 」代表美國英語，而 「en-EN 」代表英國英語。" ] ;
       fhir:ElementDefinition.comment [ fhir:value "帶有這種精確字母大小寫的aa-BB結構是最廣泛使用的地方性符號之一。但並不是所有的系統都對其進行編碼，而是將其作為純文字表述。因此，data type為CodeableConcept而不是code。" ] ;
       fhir:ElementDefinition.requirements [ fhir:value "在多語言國家的大多數系統都會想要溝通語言。並非所有的系統實際上都需要區域方言。" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
