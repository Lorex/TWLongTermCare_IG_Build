# - resource -------------------------------------------------------------------

<http://ltc-ig.fhir.tw/Organization/ltc-organization-cs100-example> a fhir:Organization ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "ltc-organization-cs100-example"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: Organization ltc-organization-cs100-example</b></p><a name=\"ltc-organization-cs100-example\"> </a><a name=\"hcltc-organization-cs100-example\"> </a><p><b>name</b>: 某某長照管理中心</p></div>"
  ] ;
  fhir:Organization.name [ fhir:value "某某長照管理中心"] .

# - ontology header ------------------------------------------------------------

<http://ltc-ig.fhir.tw/Organization/ltc-organization-cs100-example.ttl> a owl:Ontology ;
