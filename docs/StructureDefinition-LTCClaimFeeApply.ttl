         fhir:ElementDefinition.constraint.human [ fhir:value "申報照顧組合代碼 AA00（A 單位個案管理服務）時，應填寫服務項目、服務對象與服務內容。" ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "item.productOrService.coding.where(code = 'AA00').exists() implies (supportingInfo.category.coding.where(code = 'svcItem').exists() and supportingInfo.category.coding.where(code = 'svcPeople').exists() and supportingInfo.category.coding.where(code = 'svcContent').exists())" ] ;
