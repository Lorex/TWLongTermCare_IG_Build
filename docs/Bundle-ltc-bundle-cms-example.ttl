  ], [
     fhir:index 15 ;
     fhir:QuestionnaireResponse.item.linkId [ fhir:value "G8b" ] ;
     fhir:QuestionnaireResponse.item.text [ fhir:value "請問個案是否能維持站立的平衡？" ] ;
     fhir:QuestionnaireResponse.item.answer [
       fhir:index 0 ;
       fhir:QuestionnaireResponse.item.answer.valueString [ fhir:value "正常，不靠扶持能站立達一分鐘以上" ]
     ]
  ], [
     fhir:index 16 ;
     fhir:QuestionnaireResponse.item.linkId [ fhir:value "G8c" ] ;
     fhir:QuestionnaireResponse.item.text [ fhir:value "在過去 12 個月中，個案有沒有跌倒或摔倒過？" ] ;
     fhir:QuestionnaireResponse.item.answer [
       fhir:index 0 ;
       fhir:QuestionnaireResponse.item.answer.valueString [ fhir:value "沒有跌倒或摔倒過【跳答 G8d】" ]
