  fhir:QuestionnaireResponse.item [
     fhir:index 0 ;
     fhir:QuestionnaireResponse.item.linkId [ fhir:value "G1" ] ;
     fhir:QuestionnaireResponse.item.text [ fhir:value "疼痛狀況" ] ;
     fhir:QuestionnaireResponse.item.answer [
       fhir:index 0 ;
       fhir:QuestionnaireResponse.item.answer.valueString [ fhir:value "個案本人回答" ]
     ]
  ], [
     fhir:index 1 ;
     fhir:QuestionnaireResponse.item.linkId [ fhir:value "G1a" ] ;
     fhir:QuestionnaireResponse.item.text [ fhir:value "過去 1 個月中，個案身體疼痛的程度？" ] ;
     fhir:QuestionnaireResponse.item.answer [
       fhir:index 0 ;
       fhir:QuestionnaireResponse.item.answer.valueString [ fhir:value "輕微的疼痛" ]
     ]
  ], [
     fhir:index 2 ;
     fhir:QuestionnaireResponse.item.linkId [ fhir:value "G2a" ] ;
     fhir:QuestionnaireResponse.item.text [ fhir:value "請問個案現在的皮膚狀況？" ] ;
     fhir:QuestionnaireResponse.item.answer [
       fhir:index 0 ;
       fhir:QuestionnaireResponse.item.answer.valueString [ fhir:value "正常" ]
     ]
  ], [
     fhir:index 3 ;
     fhir:QuestionnaireResponse.item.linkId [ fhir:value "G2c" ] ;
     fhir:QuestionnaireResponse.item.text [ fhir:value "請問皮膚異常的狀況為何？" ] ;
     fhir:QuestionnaireResponse.item.answer [
       fhir:index 0 ;
       fhir:QuestionnaireResponse.item.answer.valueString [ fhir:value "乾燥有皮屑" ]
     ]
  ], [
     fhir:index 4 ;
     fhir:QuestionnaireResponse.item.linkId [ fhir:value "G3a" ] ;
     fhir:QuestionnaireResponse.item.text [ fhir:value "請問個案是否會因關節僵硬受限制，以致影響日常生活功能或造成照顧困難？" ] ;
     fhir:QuestionnaireResponse.item.answer [
       fhir:index 0 ;
       fhir:QuestionnaireResponse.item.answer.valueString [ fhir:value "否，沒有影響日常生活功能" ]
     ]
  ], [
     fhir:index 5 ;
     fhir:QuestionnaireResponse.item.linkId [ fhir:value "G4a" ] ;
     fhir:QuestionnaireResponse.item.text [ fhir:value "個案過去 3 個月體重是否減輕？" ] ;
     fhir:QuestionnaireResponse.item.answer [
       fhir:index 0 ;
       fhir:QuestionnaireResponse.item.answer.valueString [ fhir:value "體重無變化" ]
     ]
  ], [
     fhir:index 6 ;
     fhir:QuestionnaireResponse.item.linkId [ fhir:value "G4b" ] ;
     fhir:QuestionnaireResponse.item.text [ fhir:value "個案身體質量指數（BMI）" ] ;
     fhir:QuestionnaireResponse.item.answer [
       fhir:index 0 ;
       fhir:QuestionnaireResponse.item.answer.valueString [ fhir:value "22.5" ]
     ]
  ], [
     fhir:index 7 ;
     fhir:QuestionnaireResponse.item.linkId [ fhir:value "G4c" ] ;
     fhir:QuestionnaireResponse.item.text [ fhir:value "個案一般的飲食狀況，以週為單位" ] ;
     fhir:QuestionnaireResponse.item.answer [
       fhir:index 0 ;
       fhir:QuestionnaireResponse.item.answer.valueString [ fhir:value "每餐吃完，從不拒絕用餐，或不需任何補充食物，或灌食自製管灌飲食大於 2400c.c./日，或採用管灌飲食（或靜脈營養）大於 1200 大卡/日" ]
     ]
  ], [
     fhir:index 8 ;
     fhir:QuestionnaireResponse.item.linkId [ fhir:value "G4d1" ] ;
     fhir:QuestionnaireResponse.item.text [ fhir:value "過去一年中體重減少了 5% 以上？" ] ;
     fhir:QuestionnaireResponse.item.answer [
       fhir:index 0 ;
       fhir:QuestionnaireResponse.item.answer.valueString [ fhir:value "否" ]
     ]
  ], [
     fhir:index 9 ;
     fhir:QuestionnaireResponse.item.linkId [ fhir:value "G4d2" ] ;
     fhir:QuestionnaireResponse.item.text [ fhir:value "可以在不用手支撐的狀況下，從椅子上站起來 5 次？" ] ;
     fhir:QuestionnaireResponse.item.answer [
       fhir:index 0 ;
       fhir:QuestionnaireResponse.item.answer.valueString [ fhir:value "是" ]
     ]
  ], [
     fhir:index 10 ;
     fhir:QuestionnaireResponse.item.linkId [ fhir:value "G4d3" ] ;
     fhir:QuestionnaireResponse.item.text [ fhir:value "經常有提不起勁來做事的感覺？" ] ;
     fhir:QuestionnaireResponse.item.answer [
       fhir:index 0 ;
       fhir:QuestionnaireResponse.item.answer.valueString [ fhir:value "否" ]
     ]
  ], [
     fhir:index 11 ;
     fhir:QuestionnaireResponse.item.linkId [ fhir:value "G4f" ] ;
     fhir:QuestionnaireResponse.item.text [ fhir:value "個案尋求必要醫療時，是否需要服務介入協助？" ] ;
     fhir:QuestionnaireResponse.item.answer [
       fhir:index 0 ;
       fhir:QuestionnaireResponse.item.answer.valueString [ fhir:value "不需要協助" ]
     ]
  ], [
     fhir:index 12 ;
     fhir:QuestionnaireResponse.item.linkId [ fhir:value "G5a" ] ;
     fhir:QuestionnaireResponse.item.text [ fhir:value "個案目前是否接受進階照顧？" ] ;
     fhir:QuestionnaireResponse.item.answer [
       fhir:index 0 ;
       fhir:QuestionnaireResponse.item.answer.valueString [ fhir:value "無" ]
     ]
  ], [
     fhir:index 13 ;
     fhir:QuestionnaireResponse.item.linkId [ fhir:value "G7" ] ;
     fhir:QuestionnaireResponse.item.text [ fhir:value "個案被診斷為失智症後，照顧者是否有接受護理人員或其他專業人員提供下列的教導？" ] ;
     fhir:QuestionnaireResponse.item.answer [
       fhir:index 0 ;
       fhir:QuestionnaireResponse.item.answer.valueString [ fhir:value "未接受過教導" ]
     ]
  ], [
     fhir:index 14 ;
     fhir:QuestionnaireResponse.item.linkId [ fhir:value "G8a" ] ;
     fhir:QuestionnaireResponse.item.text [ fhir:value "請問個案是否能維持坐姿的平衡？（在沒有靠背支撐的狀況下）" ] ;
     fhir:QuestionnaireResponse.item.answer [
       fhir:index 0 ;
       fhir:QuestionnaireResponse.item.answer.valueString [ fhir:value "正常，不靠扶持能坐著達一分鐘以上" ]
