  fhir:StructureDefinition.url [ fhir:value "http://ltc-ig.fhir.tw/StructureDefinition/LTCFeeAuditStatusModel"] ;
  fhir:StructureDefinition.version [ fhir:value "1.1.0"] ;
  fhir:StructureDefinition.name [ fhir:value "LTCFeeAuditStatusModel"] ;
  fhir:StructureDefinition.title [ fhir:value "長照支付審查－分案審核狀態與交易處理結果邏輯模型"] ;
  fhir:StructureDefinition.status [ fhir:value "draft"] ;
  fhir:StructureDefinition.experimental [ fhir:value "false"^^xsd:boolean] ;
  fhir:StructureDefinition.date [ fhir:value "2026-09-17T17:33:17+08:00"^^xsd:dateTime] ;
  fhir:StructureDefinition.publisher [ fhir:value "經濟部產業發展署"] ;
  fhir:StructureDefinition.contact [
     fhir:index 0 ;
     fhir:ContactDetail.name [ fhir:value "經濟部產業發展署" ] ;
     fhir:ContactDetail.telecom [
       fhir:index 0 ;
       fhir:ContactPoint.system [ fhir:value "url" ] ;
       fhir:ContactPoint.value [ fhir:value "https://www.ida.gov.tw/" ]
