       fhir:ElementDefinition.short [ fhir:value "G4d1. 過去一年中體重減少了 5% 以上？" ] ;
       fhir:ElementDefinition.definition [ fhir:value "A group or question item from the original questionnaire for which answers are provided." ] ;
